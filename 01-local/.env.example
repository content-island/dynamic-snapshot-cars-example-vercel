# Content Island access token — project "General" tab
# https://docs.contentisland.net/ui/project/general/
CONTENT_ISLAND_ACCESS_TOKEN=YOUR_TOKEN_HERE

# Optional. Only namespaces the Redis key, so two environments pointing at
# different Content Island projects can share one Redis instance.
# Unset -> the key is "content-island:snapshot".
CONTENT_ISLAND_PROJECT_ID=

# Local Redis from docker-compose.yml.
# Managed providers inject their own name; REDIS_TLS_URL and KV_URL are accepted
# as fallbacks, in that order. Redis Cloud on Vercel sets REDIS_URL for you.
REDIS_URL=redis://localhost:6379

# Shared secret for POST /api/snapshot/refresh. Generate with:
#   openssl rand -base64 32
SNAPSHOT_REFRESH_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# How long an instance may serve its in-memory copy before re-checking the
# version in Redis. 5s locally so changes show up while you test;
# 300000 (5 min) is a sane production value.
SNAPSHOT_CHECK_INTERVAL_MS=5000

# Optional. Upper bounds on how long a request may wait on Redis, so an
# unreachable Redis cannot stall the page (or burn Vercel function time).
# Defaults: 3000 for the version check, 10000 for a full snapshot download.
# SNAPSHOT_VERSION_CHECK_TIMEOUT_MS=3000
# SNAPSHOT_LOAD_TIMEOUT_MS=10000
