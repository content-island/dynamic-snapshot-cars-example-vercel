# ---------------------------------------------------------------------------
# En LOCAL: copia este fichero a .env y rellena el token.
# En VERCEL: estas mismas variables van en Settings -> Environment Variables.
#            No subas nunca un .env al repositorio.
# ---------------------------------------------------------------------------

# Content Island access token — pestaña "General" del proyecto
# https://docs.contentisland.net/ui/project/general/
CONTENT_ISLAND_ACCESS_TOKEN=YOUR_TOKEN_HERE

# Opcional. Solo prefija la clave de Redis, para que dos entornos que apunten a
# proyectos distintos de Content Island puedan compartir una misma instancia.
# Sin valor -> la clave es "content-island:snapshot".
CONTENT_ISLAND_PROJECT_ID=

# En local, el Redis de docker-compose.yml.
# En Vercel NO la pongas a mano: la inyecta la integración de Redis Cloud al
# conectar el proyecto. El código acepta REDIS_URL, REDIS_TLS_URL y KV_URL.
# Ojo: el plan gratuito de Redis Cloud no tiene TLS, así que la URL será
# redis:// y no rediss://.
REDIS_URL=redis://localhost:6379

# Secreto compartido de POST /api/snapshot/refresh. Genéralo con:
#   openssl rand -base64 32
# El MISMO valor va en tres sitios: aquí, en Vercel, y en los secretos del
# repositorio de GitHub (para la Action que refresca al publicar).
SNAPSHOT_REFRESH_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Cuánto puede servir una instancia su copia en memoria antes de volver a
# comprobar la versión en Redis.
#   5000    (5 s)   en local, para ver los cambios mientras pruebas
#   30000   (30 s)  para grabar la demo sin tiempos muertos
#   300000  (5 min) valor razonable en producción
SNAPSHOT_CHECK_INTERVAL_MS=300000

# Opcional. Cotas de espera sobre Redis, para que un Redis inalcanzable no
# cuelgue la página ni consuma tiempo de función.
# Por defecto: 3000 para el sondeo de versión, 10000 para bajarse el snapshot.
# SNAPSHOT_VERSION_CHECK_TIMEOUT_MS=3000
# SNAPSHOT_LOAD_TIMEOUT_MS=10000
